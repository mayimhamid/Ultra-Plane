{
	servers {
		trusted_proxies static private_ranges
	}

	order rate_limit before file_server
}

:3000 {
	root * /usr/share/caddy/html

	# Per-client-IP rate limiting for static asset requests
	rate_limit {
		zone static {
			key {client_ip}
			events 300
			window 1m
		}
	}

	# Security headers (HSTS is set at the TLS terminator)
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
	}

	# Hashed build files never change: cache them for good. Everything else (the page itself, the service
	# worker, manifests, icons) is checked with the server on every load, so a new release shows up at once.
	@not_assets not path /assets/*
	header @not_assets Cache-Control "no-cache"
	header /assets/* Cache-Control "public, max-age=31536000, immutable"

	# SPA fallback
	try_files {path} /index.html
	file_server

	# Access logs to stdout (default in Caddy)
	log {
		output stdout
		format console
	}
}
